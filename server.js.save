const express = require('express');
const app = express();
//const itemsRoutes = require('./routes/itemsRoutes');
const volunteersRoutes = require('./routes/volunteersRoutes');
const ogranizersRoutes = require('./routes/ogranizersRoutes');
const eventsRoutes = require('./routes/eventsRoutes');


app.use(express.static('public'));
app.use(express.json()); // для обработки JSON-тел запросов
//app.use('/api', itemsRoutes);
app.use('/api', volunteersRoutes);
app.use('/api', ogranizersRoutes);
app.use('/api', eventsRoutes);

const port = 3000;
app.listen(port, () => {
    console.log(`Server is running on http://localhost:${port}`);
});
